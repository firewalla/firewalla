[Unit]
Description=DNSCrypt
After=network.target

[Service]
User=pi
Type=simple
Restart=always
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
WorkingDirectory=/home/pi/firewalla/
# holds the control socket, see control_socket in dnscrypt.template.toml
RuntimeDirectory=dnscrypt
RuntimeDirectoryMode=0700
ExecStart=/home/pi/firewalla/extension/dnscrypt/dnscrypt.sh
RestartSec=3

[Install]
WantedBy=multi-user.target
