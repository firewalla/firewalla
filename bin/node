#!/bin/bash

: ${FIREWALLA_HOME:=/home/pi/firewalla}
source ${FIREWALLA_HOME}/platform/platform.sh

NODE=$(get_node_bin_path)
NODE_OPTS=""
# Node on boxes with <= 2.5GB RAM: favor memory over speed (never passed to the default Node)
if [[ $NODE == $NODE_VERSIONS_DIR/* ]] && (( $(awk '/MemTotal/{print $2}' /proc/meminfo) <= 2621440 )); then
  NODE_OPTS=--optimize-for-size
fi

# Trust the system CA store, kept current by scripts/update_ca_certificates.sh, instead of the roots bundled in
# the Node binary, so a distrusted CA is dropped for Node as well. Only when the store is at least the bundled
# ca-certificates version, so a box whose store is not upgraded yet keeps the bundled roots
SYSTEM_CA_MIN_VERSION=20260816ubuntu0.22.04.1   # must match SYSTEM_CA_MIN_VERSION in firerouter bin/node
function use_system_ca {
  # --use-openssl-ca needs Node >= 7.5, a Node without a version in its path is left alone
  [[ $NODE =~ /v([0-9]+)\.[0-9]+\.[0-9]+/ ]] && (( BASH_REMATCH[1] >= 8 )) || return 1
  # manual switch back to the bundled roots
  [[ ! -e ${FIREWALLA_HIDDEN:-/home/pi/.firewalla}/config/.node_bundled_ca ]] || return 1
  [[ -s /etc/ssl/certs/ca-certificates.crt ]] || return 1
  local ca=$(dpkg-query -W -f='${db:Status-Status} ${Version}' ca-certificates 2>/dev/null)
  [[ $ca == "installed "* ]] && dpkg --compare-versions "${ca#installed }" ge $SYSTEM_CA_MIN_VERSION
}
use_system_ca && NODE_OPTS="$NODE_OPTS --use-openssl-ca"

"$NODE" $NODE_OPTS "$@"
