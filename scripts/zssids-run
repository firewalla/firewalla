#!/bin/bash
#
# Launcher for zssids when it owns the zeek role (brofish.service through
# etc/brofish-zssids.conf). Installed beside the asset, not in the git
# checkout, so a rollback cannot leave the unit pointing at a missing file.
#
#   zssids-run --prepare     what bro-run does before starting zeek: mount
#                           /bspool, run the platform before_bro hooks (they
#                           refresh ~/.firewalla/run/zeek/scripts and rebuild
#                           local.zeek from additional_options.bro, which zssids
#                           reads) and apply the sysctl profile
#   zssids-run <args...>     exec zssids with those arguments
#   zssids-run --after-bro   run the platform after_bro hooks
#
# If the checkout no longer knows about the flow engine (a soft downgrade to a
# revision without scripts/zssids-engine.sh), this hands the role back to the
# stock engine: the older code would otherwise revive zeek from its unguarded
# zeekctl cron paths and restart brofish from brofish-ping.sh while zssids ran.

: ${FIREWALLA_HOME:=/home/pi/firewalla}
: ${FIREWALLA_HIDDEN:=/home/pi/.firewalla}
source "${FIREWALLA_HOME}/platform/platform.sh"

ZSSIDS_BIN=${ZSSIDS_BIN:-$FIREWALLA_HIDDEN/run/assets/zssids}
ENGINE=$FIREWALLA_HOME/scripts/zssids-engine.sh
DROPINS=(/etc/systemd/system/brofish.service.d/zssids.conf /etc/systemd/system/suricata.service.d/zssids.conf)

# the checkout has no flow-engine support: give the units back and let systemd
# start the stock ones on the next attempt
hand_back() {
  logger "FIREWALLA:ZSSIDS-RUN $ENGINE is gone (rollback?); handing brofish and suricata back to zeek/suricata"
  local units=(brofish)
  systemctl is-active -q suricata && units+=(suricata)
  sudo rm -f "${DROPINS[@]}" 2>/dev/null || return 1
  sudo rm -f /dev/shm/zssids-engine.failed 2>/dev/null || return 1
  sudo systemctl daemon-reload 2>/dev/null || return 1
  # Do not run the stock launcher inside this already-selected Zssids start
  # transaction. Queue a fresh job so systemd reads the restored base units.
  sudo systemctl --no-block restart "${units[@]}" 2>/dev/null
}

if [[ ! -x $ENGINE ]]; then
  hand_back || logger "FIREWALLA:ZSSIDS-RUN failed to schedule stock-engine handoff"
  exit 1
fi

case "${1:-}" in
  --after-bro)
    after_bro
    exit $?
    ;;
  --prepare)
    logger "FIREWALLA:ZSSIDS-RUN preparing"
    # bro-run normally mounts this; zssids writes its live logs there
    if ! mountpoint -q /bspool && { ! mkdir -p /bspool || ! mount -t tmpfs -o size=30m tmpfs /bspool; }; then
      logger "FIREWALLA:ZSSIDS-RUN failed to prepare /bspool"
      exit 1
    fi
    before_bro || { logger "FIREWALLA:ZSSIDS-RUN before_bro failed"; exit 1; }
    sysctl_conf=$(get_sysctl_conf_path 2>/dev/null)
    if [[ -n $sysctl_conf && -f $sysctl_conf ]]; then
      cp -f "$sysctl_conf" /etc/sysctl.conf \
        && sysctl -p >/dev/null 2>&1 \
        || { logger "FIREWALLA:ZSSIDS-RUN failed to apply $sysctl_conf"; exit 1; }
    fi
    exit 0
    ;;
esac

[[ -x $ZSSIDS_BIN ]] || { logger "FIREWALLA:ZSSIDS-RUN $ZSSIDS_BIN is not executable"; exit 1; }
logger "FIREWALLA:ZSSIDS-RUN exec $ZSSIDS_BIN $*"
exec "$ZSSIDS_BIN" "$@"
